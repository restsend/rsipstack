<?xml version="1.0" encoding="UTF-8"?>
<scenario name="application_lost_bye_response">
  <recv request="INVITE"/>
  <nop><action>
    <assignstr assign_to="via" value="[last_Via:]"/>
    <assignstr assign_to="from" value="[last_From:]"/>
    <assignstr assign_to="to" value="[last_To:];tag=loss-answer"/>
    <assignstr assign_to="callid" value="[last_Call-ID:]"/>
    <assignstr assign_to="cseq" value="[last_CSeq:]"/>
    <assignstr assign_to="routes" value="[last_Record-Route:]"/>
  </action></nop>
  <send><![CDATA[
SIP/2.0 180 Ringing
[$via]
[$from]
[$to]
[$callid]
[$cseq]
[$routes]
Contact: <[sipp_uri]>
Content-Length: 0

]]></send>
  <send retrans="500"><![CDATA[
SIP/2.0 200 OK
[$via]
[$from]
[$to]
[$callid]
[$cseq]
[$routes]
Contact: <[sipp_uri]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=sipp 1 1 IN IP4 127.0.0.1
s=interop
c=IN IP4 127.0.0.1
t=0 0
m=audio 9 RTP/AVP 0
a=rtpmap:0 PCMU/8000
a=inactive
]]></send>
  <recv request="ACK"/>
  <recv request="BYE"/>
  <!-- Withhold the first BYE response and require the real transaction retry. -->
  <nop><action>
    <assignstr assign_to="first_via" value="[last_Via:]"/>
    <assignstr assign_to="first_cseq" value="[last_CSeq:]"/>
    <assignstr assign_to="first_callid" value="[last_Call-ID:]"/>
  </action></nop>
  <recv request="BYE"/>
  <nop><action>
    <assignstr assign_to="second_via" value="[last_Via:]"/>
    <assignstr assign_to="second_cseq" value="[last_CSeq:]"/>
    <assignstr assign_to="second_callid" value="[last_Call-ID:]"/>
    <strcmp assign_to="via_cmp" variable="first_via" variable2="second_via"/>
    <strcmp assign_to="cseq_cmp" variable="first_cseq" variable2="second_cseq"/>
    <strcmp assign_to="callid_cmp" variable="first_callid" variable2="second_callid"/>
    <test variable="via_cmp" compare="equal" value="0" check_it="true"/>
    <test variable="cseq_cmp" compare="equal" value="0" check_it="true"/>
    <test variable="callid_cmp" compare="equal" value="0" check_it="true"/>
  </action></nop>
  <send><![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]></send>
</scenario>
