<?xml version="1.0" encoding="UTF-8"?>
<scenario name="application_late_200">
  <recv request="INVITE"/>
  <nop><action>
    <assignstr assign_to="via" value="[last_Via:]"/>
    <assignstr assign_to="from" value="[last_From:]"/>
    <assignstr assign_to="to" value="[last_To:];tag=late-answer"/>
    <assignstr assign_to="callid" value="[last_Call-ID:]"/>
    <assignstr assign_to="cseq" value="[last_CSeq:]"/>
    <assignstr assign_to="routes" value="[last_Record-Route:]"/>
  </action></nop>
  <send><![CDATA[
SIP/2.0 180 Ringing
[$via]
[$from]
[$to]
[$callid]
[$cseq]
[$routes]
Contact: <[sipp_uri]>
Content-Length: 0

]]></send>
  <recv request="CANCEL"/>
  <send><![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]></send>
  <send retrans="500"><![CDATA[
SIP/2.0 200 OK
[$via]
[$from]
[$to]
[$callid]
[$cseq]
[$routes]
Contact: <[sipp_uri]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=sipp 1 1 IN IP4 127.0.0.1
s=interop
c=IN IP4 127.0.0.1
t=0 0
m=audio 9 RTP/AVP 0
a=rtpmap:0 PCMU/8000
a=inactive
]]></send>
  <!-- Independent proxy tasks and UDP can reorder ACK and BYE. Require both
       messages, but accept either arrival order at the downstream UAS. -->
  <!-- Keep accepting ACK while the BYE response is queued, without replacing
       the saved BYE headers used by that response. -->
  <recv request="ACK" optional="global" advance_state="false"><action>
    <assign assign_to="ack_seen" value="1"/>
  </action></recv>
  <recv request="BYE"/>
  <send><![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]></send>
  <nop next="1" test="ack_seen"/>
  <recv request="ACK"/>
  <label id="1"/>
</scenario>
