<?xml version="1.0" encoding="UTF-8"?>
<scenario name="CANCEL crossed a successful INVITE response">
  <recv request="INVITE"/>
  <nop><action>
    <assignstr assign_to="via" value="[last_Via:]"/>
    <assignstr assign_to="from" value="[last_From:]"/>
    <assignstr assign_to="to" value="[last_To:]"/>
    <assignstr assign_to="call_id" value="[last_Call-ID:]"/>
    <assignstr assign_to="cseq" value="[last_CSeq:]"/>
  </action></nop>
  <send><![CDATA[
SIP/2.0 180 Ringing
[$via]
[$from]
[$to];tag=sipp-test
[$call_id]
[$cseq]
Content-Length: 0

]]></send>
  <recv request="CANCEL"/>
  <send><![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=sipp-test
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]></send>
  <send><![CDATA[
SIP/2.0 200 OK
[$via]
[$from]
[$to];tag=sipp-test
[$call_id]
[$cseq]
Contact: <[sipp_uri]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=sipp 1 1 IN IP4 127.0.0.1
s=interop
c=IN IP4 127.0.0.1
t=0 0
m=audio 9 RTP/AVP 0
a=rtpmap:0 PCMU/8000
a=inactive
]]></send>
  <recv request="ACK"/>
  <recv request="BYE"/>
  <send><![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]></send>
</scenario>
